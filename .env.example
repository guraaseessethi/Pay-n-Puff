# Copy to .env.local for local dev. Never commit real values.

# Signs the verified-customer, staff, settings and magic-link cookies. 32+ random characters.
# Required in production. Generate one with:  openssl rand -base64 48
VERIFY_COOKIE_SECRET=

# Phase 1: mock (sample data + this browser's storage). Phase 2: supabase.
NEXT_PUBLIC_DATA_SOURCE=mock

# Public URL, used for sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Compliance defaults (the owner can override in admin Settings).
MIN_AGE=19
DELIVERY_ENABLED=true
RESERVATIONS_ENABLED=true
# PROMOTIONS_ENABLED is hard-wired to false in lib/compliance/policy.ts until the health unit confirms.
